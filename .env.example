# Local single-process development; copy to .env (never commit .env)
DATABASE_URL=sqlite:///./insightflow.db
INSIGHTFLOW_ADMIN_TOKEN=change-to-long-random-private-value
ALLOWED_ORIGINS=https://agkau.github.io,http://localhost:4173,http://localhost:8000
# Optional directory-based batch refresh (single worker and persistent disk only):
ENABLE_INBOX_SCHEDULER=0
IMPORT_INBOX_DIR=./inbox
SCHEDULE_INTERVAL_SECONDS=3600
